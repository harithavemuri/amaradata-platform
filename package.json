{
  "name": "amaradata-platform",
  "version": "1.1.0",
  "description": "AmaraData SaaS platform — tenant management and billing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:nondb": "NONDB_MODE=true nodemon server.js",
    "test": "vitest run && vitest run --config vitest.config.nondb.js && vitest run --config testing/unittests/vitest.config.js",
    "test:db": "vitest run",
    "test:nondb": "vitest run --config vitest.config.nondb.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unittests": "vitest run --config testing/unittests/vitest.config.js",
    "test:unittests:watch": "vitest --config testing/unittests/vitest.config.js",
    "test:regression": "playwright test --config testing/regression_testsuite/playwright.config.js",
    "test:regression:ui": "playwright test --config testing/regression_testsuite/playwright.config.js --ui",
    "test:regression:db": "cross-env REGRESSION_DB=1 playwright test --config testing/regression_testsuite/playwright.config.js",
    "test:regression:all": "npm run test:regression:db && npm run test:regression",
    "test:release-tracking": "playwright test --config testing/release-tracking/playwright.config.release-checks.js",
    "test:load": "node scripts/run-load-test.js",
    "test:throughput": "node scripts/run-throughput-test.js",
    "test:throughput:db": "node scripts/run-throughput-test.js --mode db",
    "test:all": "npm test && npm run test:regression:all && npm run test:release-tracking && npm run smoke",
    "deploy": "npm test && npm run test:regression:db && npm run test:regression && npm run test:release-tracking && node scripts/tag-release.js && sam build && sam deploy --no-confirm-changeset && node scripts/db-migrate.js && aws s3 sync frontend/ s3://amrd-platform-amaradata-prod-797666412164/ --delete && aws cloudfront create-invalidation --distribution-id EVRE22H489D0P --paths \"/*\" && npm run smoke:lifecycle",
    "smoke": "node -r dotenv/config scripts/smoke-prod.js",
    "smoke:lifecycle": "node -r dotenv/config scripts/smoke-lifecycle.js",
    "export-db": "node scripts/cli.js export-db",
    "check-db": "node scripts/cli.js check-db",
    "stats": "node scripts/cli.js stats",
    "sync": "node scripts/cli.js sync",
    "sync-tenant-fixes": "node jobs/sync-tenant-fixes.js",
    "seed:local": "node scripts/seed-enhancements.js --target=local",
    "seed:production": "node scripts/seed-enhancements.js --target=production"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "@aws-sdk/client-ses": "^3.1053.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "graphql": "^16.14.0",
    "graphql-http": "^1.22.4",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.9",
    "nodemailer": "^8.0.10",
    "pg": "^8.11.5",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.600.0",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "autocannon": "^8.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^24.0.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "vitest": "^4.1.7"
  }
}
