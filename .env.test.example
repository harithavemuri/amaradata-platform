# AmaraData Platform — smoke-test / release-check credential template
# Copy to .env.test and fill in real values. .env.test itself is gitignored —
# never commit real credentials.

# ── Production smoke test (scripts/smoke-prod.js) ────────────────────────────
# An existing account in production. scripts/smoke-lifecycle.js enables it
# immediately before the smoke run and disables it immediately after.
SMOKE_TEST_USER=smoketest.admin
SMOKE_TEST_ADMIN_PASSWORD=

# ── Bootstrap account (scripts/smoke-lifecycle.js) ───────────────────────────
# A permanent site_admin account used ONLY to toggle SMOKE_TEST_USER's
# is_active flag via PUT /api/admin/users/:id. Must already exist in
# production and must never itself be the account that gets disabled.
SMOKE_BOOTSTRAP_ADMIN_USER=
SMOKE_BOOTSTRAP_ADMIN_PASSWORD=

# ── Playwright release-tracking checks (testing/release-tracking/) ──────────
# Leave unset to run release checks against the local NonDB server (default).
# Set to a real deployed URL to run them there instead (uses the smoke
# credentials above for login).
# PW_BASE_URL=https://amaradata.com
